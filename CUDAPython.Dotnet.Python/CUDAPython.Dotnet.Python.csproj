<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CUDAPythonProvisionEnvironment Condition="'$(CUDAPythonProvisionEnvironment)' == ''">true</CUDAPythonProvisionEnvironment>
    <CUDAPythonUpdateEnvironment Condition="'$(CUDAPythonUpdateEnvironment)' == ''">false</CUDAPythonUpdateEnvironment>
    <CUDAPythonEnvironmentUpdateArgument Condition="'$(CUDAPythonUpdateEnvironment)' == 'true'">-Upgrade</CUDAPythonEnvironmentUpdateArgument>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.2.1" />
  </ItemGroup>

  <Target Name="ValidateBundledPythonRuntime" BeforeTargets="Build" Condition="'$(CUDAPythonProvisionEnvironment)' == 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'linux-x64'" Text="The bundled CPython runtime supports the win-x64 and linux-x64 RIDs (x64 only). Set CUDAPythonProvisionEnvironment=false to build the managed wrapper only." />
  </Target>

  <!-- Provision the Windows x64 Python environment (default when no RID or win-x64). -->
  <Target Name="ProvisionBundledPythonRuntimeWin" AfterTargets="Build" Condition="'$(CUDAPythonProvisionEnvironment)' == 'true' and ('$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'win-x64') and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Update-CudaPythonEnvironment.ps1&quot; -EnvironmentPath &quot;$(TargetDir)python-env-win-x64&quot; -RuntimeId win-x64 $(CUDAPythonEnvironmentUpdateArgument)" />
  </Target>

  <!--
    Provision the Linux x64 Python environment.
    On Windows this requires WSL; on a Linux host it runs natively.
    The target is skipped if the environment already exists (idempotent).
  -->
  <Target Name="ProvisionBundledPythonRuntimeLinux" AfterTargets="Build" Condition="'$(CUDAPythonProvisionEnvironment)' == 'true' and '$(RuntimeIdentifier)' == 'linux-x64'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Update-CudaPythonEnvironment.ps1&quot; -EnvironmentPath &quot;$(TargetDir)python-env-linux-x64&quot; -RuntimeId linux-x64 $(CUDAPythonEnvironmentUpdateArgument)" />
  </Target>

</Project>
