<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.19.0" />
    <ProjectReference Include="..\CUDAPython.Dotnet.Python\CUDAPython.Dotnet.Python.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\scripts\Update-CudaPythonEnvironment.ps1"
             Link="tools\Update-CudaPythonEnvironment.ps1"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\scripts\python-runtime-win-x64.json"
             Link="tools\python-runtime-win-x64.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyBundledPythonRuntimeToApiOutput" AfterTargets="Build">
    <ItemGroup>
      <ApiPythonFile Include="..\CUDAPython.Dotnet.Python\bin\$(Configuration)\net10.0\python-env\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ApiPythonFile)"
          DestinationFiles="@(ApiPythonFile->'$(TargetDir)python-env\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPythonRuntimeToApiPublish" AfterTargets="Publish">
    <ItemGroup>
      <ApiPythonPublishFile Include="..\CUDAPython.Dotnet.Python\bin\$(Configuration)\net10.0\python-env\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ApiPythonPublishFile)"
          DestinationFiles="@(ApiPythonPublishFile->'$(PublishDir)python-env\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
